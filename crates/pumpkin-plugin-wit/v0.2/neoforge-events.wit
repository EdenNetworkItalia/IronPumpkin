/// The records of the events that IronPumpkin fires with the names, fields, cancel and result
/// rules of NeoForge 26.3, at fire sites where Pumpkin has no event.
///
/// A block state is a block state id. A blocking handler writes back only the fields that its
/// record names as settable; the host keeps the other fields.
interface neoforge-events {
    use common.{block-pos, hand, position};
    use item-stack.{item-stack, enchantment-value};
    use player.{player};
    use text.{text-component};
    use %world.{%world, entity, block-direction};
    use game-rules.{game-rule, game-rule-value};
    use damage-types.{damage-type};

    /// NeoForge `TriState`: allow, let vanilla decide, or refuse.
    enum tri-state {
        %true,
        default,
        %false,
    }

    /// Vanilla `InteractionResult`.
    enum interaction-result {
        /// The action ran, and the other players see the arm swing.
        success,
        /// The action ran, and every player sees the arm swing.
        success-server,
        /// The action ran, without a swing.
        consume,
        fail,
        pass,
        /// The block use goes on as with an empty hand.
        try-with-empty-hand,
    }

    /// NeoForge `PlayerInteractEvent.LeftClickBlock.Action`: the dig action of a left click.
    enum left-click-block-action {
        start,
        stop,
        abort,
    }

    /// NeoForge `UseItemOnBlockEvent.UsePhase`.
    enum use-phase {
        /// The item use before the block use. Pumpkin items have none.
        item-before-block,
        block,
        /// The item use on the block, which also places a block item.
        item-after-block,
    }

    /// NeoForge `PistonEvent.PistonMoveType`.
    enum piston-move-type {
        extend,
        retract,
    }

    /// Vanilla `MobCategory`.
    enum mob-category {
        monster,
        creature,
        ambient,
        axolotls,
        underground-water-creature,
        water-creature,
        water-ambient,
        misc,
    }

    /// A mob that the natural spawner may spawn. The biome lists of Pumpkin have no weights.
    record spawner-data {
        /// The namespaced entity type, such as `minecraft:zombie`.
        entity-type: string,
        min-count: s32,
        max-count: s32,
    }

    /// NeoForge `UseItemOnBlockEvent`: one phase of a right click on a block, after the
    /// player interact event with the action right click block. Settable: `cancellation-result`.
    /// A cancel skips the phase and gives `cancellation-result` in place of its result.
    record use-item-on-block-event-data {
        player: player,
        hand: hand,
        /// A copy of the stack in `hand` at the start of the phase.
        item: item-stack,
        block-pos: block-pos,
        face: block-direction,
        /// The clicked point, in world coordinates.
        hit-vector: position,
        phase: use-phase,
        cancellation-result: interaction-result,
        cancelled: bool,
    }

    /// NeoForge `BlockEvent.EntityPlaceEvent` for an entity that is not a player, before the
    /// block changes. A cancel keeps the block.
    record block-event-entity-place-event-data {
        entity: entity,
        target-world: %world,
        block-pos: block-pos,
        placed-state-id: u16,
        replaced-state-id: u16,
        /// The state of the block below `block-pos`.
        placed-against-state-id: u16,
        cancelled: bool,
    }

    /// NeoForge `BlockEvent.BlockToolModificationEvent`: a fire starter or shears change a
    /// block. Settable: `final-state-id`, where `none` is no change and `state-id` keeps the
    /// vanilla change. A cancel is no change.
    record block-event-block-tool-modification-event-data {
        target-world: %world,
        block-pos: block-pos,
        /// `none` for a dispenser.
        player: option<player>,
        held-item: item-stack,
        /// The NeoForge `ItemAbility`, such as `firestarter_light` or `shears_trim`.
        item-ability: string,
        simulated: bool,
        state-id: u16,
        final-state-id: option<u16>,
        cancelled: bool,
    }

    /// NeoForge `CropGrowEvent.Post`: a crop grew one age in its random tick.
    record crop-grow-event-post-data {
        target-world: %world,
        block-pos: block-pos,
        original-state-id: u16,
        state-id: u16,
    }

    /// NeoForge `CreateFluidSourceEvent`: a fluid source counts toward a new source next to it.
    /// Settable: `can-convert`.
    record create-fluid-source-event-data {
        target-world: %world,
        block-pos: block-pos,
        state-id: u16,
        vanilla-result: bool,
        can-convert: bool,
    }

    /// NeoForge `NoteBlockEvent.Change`: a player tunes a note block. Settable: `note`, the note
    /// id from 0 to 24; a value above 24 keeps the vanilla note. A cancel keeps the note.
    record note-block-event-change-data {
        target-world: %world,
        block-pos: block-pos,
        state-id: u16,
        old-note: u8,
        note: u8,
        cancelled: bool,
    }

    /// NeoForge `PistonEvent.Post`: a piston moved its blocks.
    record piston-event-post-data {
        target-world: %world,
        /// The position of the piston base.
        block-pos: block-pos,
        /// The state of the piston base after the move.
        state-id: u16,
        direction: block-direction,
        move-type: piston-move-type,
    }

    /// NeoForge `ExplosionEvent.Detonate`: an explosion has its blocks and entities and has
    /// changed nothing yet. Settable: `affected-blocks` and `affected-entities`; the explosion
    /// changes and damages only what the last handler left.
    record explosion-event-detonate-data {
        target-world: %world,
        center: position,
        power: f32,
        affected-blocks: list<block-pos>,
        affected-entities: list<entity>,
    }

    /// NeoForge `ExplosionKnockbackEvent`: an explosion pushes an entity. Settable: `knockback`.
    record explosion-knockback-event-data {
        target-world: %world,
        center: position,
        power: f32,
        entity: entity,
        knockback: position,
        affected-blocks: list<block-pos>,
    }

    /// NeoForge `ChunkWatchEvent.UnWatch`: a player stops watching a chunk.
    record chunk-watch-event-un-watch-data {
        player: player,
        target-world: %world,
        chunk-x: s32,
        chunk-z: s32,
    }

    /// NeoForge `GameRuleChangedEvent`: a game rule changed.
    record game-rule-changed-event-data {
        rule: game-rule,
        value: game-rule-value,
    }

    /// NeoForge `LevelEvent.PotentialSpawns`: the natural spawner reads the mobs that may spawn at
    /// a position. Settable: `spawns`; an entry with an unknown entity type is dropped. A cancel
    /// spawns nothing.
    record level-event-potential-spawns-data {
        target-world: %world,
        category: mob-category,
        block-pos: block-pos,
        spawns: list<spawner-data>,
        cancelled: bool,
    }

    /// Why a mob spawns: vanilla `EntitySpawnReason`.
    enum entity-spawn-reason {
        natural,
        chunk-generation,
        spawner,
        structure,
        breeding,
        mob-summoned,
        jockey,
        event,
        conversion,
        reinforcement,
        triggered,
        bucket,
        spawn-item-use,
        command,
        dispenser,
        patrol,
        trial-spawner,
        load,
        dimension-travel,
    }

    /// The result of a spawn check: pass, let the server decide, or fail.
    enum mob-spawn-result {
        succeed,
        default,
        fail,
    }

    /// NeoForge `MobDespawnEvent.Result`: despawn now, let the server decide, or stay.
    enum mob-despawn-result {
        allow,
        default,
        deny,
    }

    /// A block that a projectile hit.
    record projectile-block-hit {
        block-pos: block-pos,
        face: block-direction,
        /// The point of the hit.
        location: position,
    }

    /// An entity that a projectile hit.
    record projectile-entity-hit {
        entity: entity,
        /// The point of the hit.
        location: position,
    }

    /// What a projectile hit (vanilla `HitResult`).
    variant projectile-hit {
        block(projectile-block-hit),
        entity(projectile-entity-hit),
    }

    /// NeoForge `EntityLeaveLevelEvent`: an entity left its world.
    record entity-leave-level-event-data {
        entity: entity,
        target-world: %world,
    }

    /// NeoForge `EntityMobGriefingEvent`: an entity checks the `mobGriefing` game rule.
    /// Settable: `can-grief`.
    record entity-mob-griefing-event-data {
        entity: entity,
        mob-griefing-enabled: bool,
        can-grief: bool,
    }

    /// NeoForge `EntityStruckByLightningEvent`: a bolt is about to strike an entity. A cancel
    /// spares the entity.
    record entity-struck-by-lightning-event-data {
        entity: entity,
        lightning: entity,
        cancelled: bool,
    }

    /// NeoForge `EntityTeleportEvent.SpreadPlayersCommand`: `/spreadplayers` is about to move an
    /// entity. Settable: `target`. A cancel leaves the entity where it is.
    record entity-teleport-event-spread-players-command-data {
        entity: entity,
        target-world: %world,
        target: position,
        cancelled: bool,
    }

    /// NeoForge `ProjectileImpactEvent`: a projectile hits a block or an entity. A cancel skips
    /// the hit, and the projectile flies on.
    record projectile-impact-event-data {
        projectile: entity,
        ray: projectile-hit,
        cancelled: bool,
    }

    /// NeoForge `EndermanAngerEvent`: a player stares at an enderman. A cancel makes the stare
    /// not count.
    record enderman-anger-event-data {
        entity: entity,
        player: player,
        cancelled: bool,
    }

    /// NeoForge `MobDespawnEvent`: a mob checks whether it despawns. Settable: `result`.
    record mob-despawn-event-data {
        entity: entity,
        target-world: %world,
        position: position,
        %result: mob-despawn-result,
    }

    /// NeoForge `MobSpawnEvent.PositionCheck`: the spawner checks the position of a created mob.
    /// Settable: `result`.
    record mob-spawn-event-position-check-data {
        entity: entity,
        target-world: %world,
        position: position,
        spawn-type: entity-spawn-reason,
        /// The position of the mob spawner block, for a mob spawner.
        spawner: option<block-pos>,
        %result: mob-spawn-result,
    }

    /// NeoForge `MobSpawnEvent.SpawnPlacementCheck`: the spawn rules of an entity type decide
    /// whether it may spawn at a position. Settable: `result`.
    record mob-spawn-event-spawn-placement-check-data {
        /// The namespaced entity type, such as `minecraft:zombie`.
        entity-type: string,
        target-world: %world,
        spawn-type: entity-spawn-reason,
        block-pos: block-pos,
        /// The result of the spawn rules.
        default-result: bool,
        %result: mob-spawn-result,
    }

    /// NeoForge `MobSplitEvent`: a dead slime or magma cube splits. Settable: `children`, where
    /// the host keeps only the children of the event, in the order of the list. A cancel spawns
    /// no child.
    record mob-split-event-data {
        parent: entity,
        children: list<entity>,
        cancelled: bool,
    }

    /// NeoForge `SpawnClusterSizeEvent`: the natural spawner reads how many mobs of one pack may
    /// spawn in a chunk. Settable: `size`.
    record spawn-cluster-size-event-data {
        entity: entity,
        size: s32,
    }

    /// NeoForge `EntityInvulnerabilityCheckEvent`: an entity checks whether a damage can hurt it.
    /// Settable: `invulnerable`.
    record entity-invulnerability-check-event-data {
        entity: entity,
        damage-type: damage-type,
        /// The entity that caused the damage.
        attacker: option<entity>,
        original-invulnerable: bool,
        invulnerable: bool,
    }

    /// NeoForge `EntityTickEvent.Pre`: an entity that is not a player is about to tick. A cancel
    /// skips the tick and the post event.
    record entity-tick-event-pre-data {
        entity: entity,
        cancelled: bool,
    }

    /// NeoForge `EntityTickEvent.Post`: an entity that is not a player ticked.
    record entity-tick-event-post-data {
        entity: entity,
    }

    /// NeoForge `PlayerTickEvent.Pre`: the start of the tick of a player.
    record player-tick-event-pre-data {
        player: player,
    }

    /// NeoForge `PlayerTickEvent.Post`: the end of the tick of a player.
    record player-tick-event-post-data {
        player: player,
    }

    // The living entity events (`event.entity.living`). The entity of a record is the living
    // entity, a player included.

    /// NeoForge `DamageSource`.
    record damage-source {
        damage-type: damage-type,
        /// The entity that dealt the damage, such as an arrow.
        direct-entity: option<entity>,
        /// The entity responsible for the damage, such as the shooter of the arrow.
        causing-entity: option<entity>,
        /// The position that the damage comes from, for a damage without an entity.
        source-position: option<position>,
    }

    /// NeoForge `DamageContainer.Reduction`. `magic` holds the enchantments and the mob effects,
    /// which Pumpkin computes in one step.
    record damage-reductions {
        invulnerability: f32,
        armor: f32,
        magic: f32,
        absorption: f32,
    }

    /// An effect of a living entity, by its namespaced id such as `minecraft:speed`.
    record mob-effect-data {
        effect-id: string,
        duration: s32,
        amplifier: u8,
        ambient: bool,
        show-particles: bool,
        show-icon: bool,
    }

    /// NeoForge `MobEffectEvent.Applicable.Result`.
    enum mob-effect-event-applicable-result {
        apply,
        default,
        do-not-apply,
    }

    /// NeoForge `LivingDamageEvent.Pre`: a damage is about to change the health, after the
    /// armor, the effects and the hurt cooldown. Settable: `new-damage`.
    record living-damage-event-pre-data {
        entity: entity,
        source: damage-source,
        original-damage: f32,
        new-damage: f32,
    }

    /// NeoForge `LivingDamageEvent.Post`: a damage changed the health.
    record living-damage-event-post-data {
        entity: entity,
        source: damage-source,
        original-damage: f32,
        inflicted-damage: f32,
        health-damage: f32,
        blocked-damage: f32,
        shield-damage: f32,
        post-attack-invulnerability-ticks: s32,
        should-cause-side-effects: bool,
        reductions: damage-reductions,
    }

    /// NeoForge `LivingEntityUseItemEvent.Start`: an item use starts. Settable: `duration`. A
    /// cancel or a negative duration starts no use.
    record living-entity-use-item-event-start-data {
        entity: entity,
        item: item-stack,
        hand: hand,
        duration: s32,
        cancelled: bool,
    }

    /// NeoForge `LivingEntityUseItemEvent.Tick`: a tick of an item use. Settable: `duration`, the
    /// remaining ticks. A cancel sets them to -1; with no remaining tick the use finishes.
    record living-entity-use-item-event-tick-data {
        entity: entity,
        item: item-stack,
        hand: hand,
        duration: s32,
        cancelled: bool,
    }

    /// NeoForge `LivingEntityUseItemEvent.Stop`: a player releases the item it uses. A cancel
    /// skips the release of the item.
    record living-entity-use-item-event-stop-data {
        entity: entity,
        item: item-stack,
        hand: hand,
        duration: s32,
        cancelled: bool,
    }

    /// NeoForge `LivingKnockBackEvent`: a knockback before the knockback resistance. Settable:
    /// `strength`, `ratio-x` and `ratio-z`. A cancel gives no knockback.
    record living-knock-back-event-data {
        entity: entity,
        strength: f32,
        ratio-x: f64,
        ratio-z: f64,
        original-strength: f32,
        original-ratio-x: f64,
        original-ratio-z: f64,
        cancelled: bool,
    }

    /// NeoForge `LivingFallEvent`: a fall that may deal damage. Settable: `distance` and
    /// `damage-multiplier`. A cancel deals no fall damage.
    record living-fall-event-data {
        entity: entity,
        distance: f64,
        damage-multiplier: f32,
        cancelled: bool,
    }

    /// NeoForge `LivingDrownEvent`: a player out of air under water. Settable: `drowning`,
    /// `damage-amount` and `bubble-count`. A cancel deals no damage.
    record living-drown-event-data {
        entity: entity,
        drowning: bool,
        damage-amount: f32,
        bubble-count: s32,
        cancelled: bool,
    }

    /// NeoForge `LivingExperienceDropEvent`: a killed entity drops experience. Settable:
    /// `dropped-experience`. A cancel drops none.
    record living-experience-drop-event-data {
        entity: entity,
        attacking-player: option<player>,
        original-experience: s32,
        dropped-experience: s32,
        cancelled: bool,
    }

    /// NeoForge `LivingShieldBlockEvent`: a damage to an entity that uses a shield. Settable:
    /// `blocked-damage`, `shield-damage` (-1 keeps the vanilla durability loss) and `blocked`.
    record living-shield-block-event-data {
        entity: entity,
        source: damage-source,
        damage: f32,
        original-blocked-damage: f32,
        blocked-damage: f32,
        shield-damage: s32,
        original-blocked: bool,
        blocked: bool,
    }

    /// NeoForge `LivingGetProjectileEvent`: the ammunition of a bow or a crossbow. Settable:
    /// `projectile`; the server takes nothing from the inventory for a changed projectile.
    record living-get-projectile-event-data {
        entity: entity,
        projectile-weapon: item-stack,
        projectile: item-stack,
    }

    /// NeoForge `LivingEvent.LivingJumpEvent`: an entity jumped from the ground.
    record living-event-living-jump-event-data {
        entity: entity,
    }

    /// NeoForge `LivingEvent.LivingVisibilityEvent`: a mob reads the visibility of an entity.
    /// Settable: `visibility-modifier`.
    record living-event-living-visibility-event-data {
        entity: entity,
        looking-entity: option<entity>,
        visibility-modifier: f64,
    }

    /// NeoForge `LivingDestroyBlockEvent`: an entity is about to destroy a block. A cancel keeps
    /// the block.
    record living-destroy-block-event-data {
        entity: entity,
        block-pos: block-pos,
        state-id: u16,
        cancelled: bool,
    }

    /// NeoForge `LivingConversionEvent.Post`: a mob converted to `outcome`.
    record living-conversion-event-post-data {
        entity: entity,
        outcome: entity,
    }

    /// NeoForge `EffectParticleModificationEvent`: the particle of an effect. Settable:
    /// `particle-color`, the ARGB colour of `minecraft:entity_effect`, and `visible`.
    record effect-particle-modification-event-data {
        entity: entity,
        effect: mob-effect-data,
        original-particle-color: s32,
        particle-color: s32,
        visible: bool,
    }

    /// NeoForge `MobEffectEvent.Applicable`: an effect is about to apply. Settable: `result`.
    record mob-effect-event-applicable-data {
        entity: entity,
        effect: mob-effect-data,
        effect-source: option<entity>,
        %result: mob-effect-event-applicable-result,
    }

    // The player events (`event.entity.player`) and the container and level events that only
    // native mods saw before.

    /// NeoForge `AnvilCraftEvent.Pre`: a player takes the result of an anvil, before the cost is
    /// paid and the inputs are used. A cancel skips the end of the take: the player keeps the
    /// output, pays no levels and the inputs stay.
    record anvil-craft-event-pre-data {
        player: player,
        left: item-stack,
        right: item-stack,
        output: item-stack,
        cancelled: bool,
    }

    /// NeoForge `AnvilCraftEvent.Post`: a player took the result of an anvil. `left` and `right`
    /// are the inputs before the take.
    record anvil-craft-event-post-data {
        player: player,
        left: item-stack,
        right: item-stack,
        output: item-stack,
    }

    /// NeoForge `ArrowNockEvent`: a player starts to draw a bow. Settable: `action`. A cancel, or
    /// a set `action`, stops the draw.
    record arrow-nock-event-data {
        player: player,
        bow: item-stack,
        hand: hand,
        target-world: %world,
        /// Whether the player has an arrow, or needs none.
        has-ammo: bool,
        action: option<interaction-result>,
        cancelled: bool,
    }

    /// NeoForge `ArrowLooseEvent`: a player releases a drawn bow. Settable: `charge`, the ticks
    /// the bow was drawn. A cancel shoots nothing.
    record arrow-loose-event-data {
        player: player,
        bow: item-stack,
        target-world: %world,
        has-ammo: bool,
        charge: s32,
        cancelled: bool,
    }

    /// NeoForge `CriticalHitEvent`: decides whether a player attack is a critical hit. Settable:
    /// `damage-multiplier` (a negative value counts as 0), `critical-hit` and `disable-sweep`.
    record critical-hit-event-data {
        player: player,
        target: entity,
        /// 1.5 for a vanilla critical hit, 1.0 otherwise.
        vanilla-multiplier: f32,
        vanilla-critical: bool,
        damage-multiplier: f32,
        critical-hit: bool,
        /// Whether a critical hit stops the sweep.
        disable-sweep: bool,
    }

    /// NeoForge `SweepAttackEvent`: decides whether a player attack sweeps. Settable: `sweeping`,
    /// also on a cancel.
    record sweep-attack-event-data {
        player: player,
        target: entity,
        vanilla-sweep: bool,
        sweeping: bool,
        cancelled: bool,
    }

    /// NeoForge `PlayerEvent.BreakSpeed`: the mining speed of a player on a block, on every mining
    /// step. Settable: `new-speed`. A cancel makes the block unbreakable for this step.
    record player-event-break-speed-data {
        player: player,
        state-id: u16,
        original-speed: f32,
        new-speed: f32,
        block-pos: option<block-pos>,
        cancelled: bool,
    }

    /// NeoForge `PlayerEvent.HarvestCheck`: whether a player gets the drops of a block. Settable:
    /// `can-harvest`.
    record player-event-harvest-check-data {
        player: player,
        state-id: u16,
        block-pos: block-pos,
        can-harvest: bool,
    }

    /// NeoForge `PlayerEvent.NameFormat`: the display name of a player. Settable: `display-name`.
    record player-event-name-format-data {
        player: player,
        username: text-component,
        display-name: text-component,
    }

    /// NeoForge `PlayerEvent.TabListNameFormat`: the name of a player in the tab list. Settable:
    /// `display-name`, where `none` shows the player name.
    record player-event-tab-list-name-format-data {
        player: player,
        display-name: option<text-component>,
    }

    /// NeoForge `PlayerEvent.StartTracking`: an entity became visible to a player.
    record player-event-start-tracking-data {
        player: player,
        target: entity,
    }

    /// NeoForge `PlayerEvent.StopTracking`: an entity is no longer visible to a player.
    record player-event-stop-tracking-data {
        player: player,
        target: entity,
    }

    /// NeoForge `PlayerEvent.LoadFromFile`: the server loaded the data of a joining player.
    record player-event-load-from-file-data {
        player: player,
        /// The directory of the player data files.
        player-directory: string,
        player-uuid: string,
    }

    /// NeoForge `PlayerEvent.SaveToFile`: the server saves the data of a player.
    record player-event-save-to-file-data {
        player: player,
        /// The directory of the player data files.
        player-directory: string,
        player-uuid: string,
    }

    /// NeoForge `PlayerFlyableFallEvent`: a player that may fly lands and takes no fall damage.
    record player-flyable-fall-event-data {
        player: player,
        distance: f32,
        multiplier: f32,
    }

    /// NeoForge `PlayerXpEvent.PickupXp`: a player picks up an experience orb. A cancel leaves the
    /// orb.
    record player-xp-event-pickup-xp-data {
        player: player,
        orb: entity,
        /// The experience of the orb.
        amount: u32,
        cancelled: bool,
    }

    /// NeoForge `ItemEntityPickupEvent.Pre`: a player touches an item entity. Settable:
    /// `can-pickup`: `false` stops the pickup, `true` ignores the pickup delay, `default` lets
    /// the server decide.
    record item-entity-pickup-event-pre-data {
        player: player,
        item-entity: entity,
        can-pickup: tri-state,
    }

    /// NeoForge `ItemEntityPickupEvent.Post`: a player picked up some or all of an item entity.
    record item-entity-pickup-event-post-data {
        player: player,
        item-entity: entity,
        /// The stack of the item entity before the pickup.
        original-stack: item-stack,
        /// The stack left in the item entity, empty when the player took all of it.
        current-stack: item-stack,
    }

    /// NeoForge `PlayerSwitchHotbarSlotEvent.Post`: a player selected another hotbar slot.
    record player-switch-hotbar-slot-event-post-data {
        player: player,
        old-slot-index: u8,
        new-slot-index: u8,
    }

    /// A trade of a villager or a wandering trader (vanilla `MerchantOffer`).
    record merchant-offer {
        base-cost-a: item-stack,
        cost-b: option<item-stack>,
        output: item-stack,
        reward-exp: bool,
        uses: s32,
        max-uses: s32,
        xp: s32,
        special-price: s32,
        price-multiplier: f32,
        demand: s32,
    }

    /// NeoForge `TradeWithVillagerEvent`: a player completed a trade with a villager or a
    /// wandering trader. `offer` is a copy made when the merchant counted the use.
    record trade-with-villager-event-data {
        player: player,
        offer: merchant-offer,
        villager: entity,
    }

    /// Vanilla `ChatVisiblity`.
    enum chat-mode {
        enabled,
        commands-only,
        hidden,
    }

    /// Vanilla `ParticleStatus`.
    enum particle-status {
        all,
        decreased,
        minimal,
    }

    /// The client settings of a player (vanilla `ClientInformation`).
    record client-information {
        locale: string,
        view-distance: u8,
        chat-mode: chat-mode,
        chat-colors: bool,
        /// The shown skin parts, one bit per part.
        skin-parts: u8,
        main-hand: hand,
        text-filtering: bool,
        server-listing: bool,
        particle-status: particle-status,
    }

    /// NeoForge `ClientInformationUpdatedEvent`: a player in play sent its client settings, also
    /// when nothing changed.
    record client-information-updated-event-data {
        player: player,
        old-information: client-information,
        updated-information: client-information,
    }

    /// NeoForge `PotionBrewEvent.Post`: a brewing stand brewed. Settable: `stacks`, the three
    /// bottles, the ingredient and the fuel; the host takes back the stack at each index and keeps
    /// its own stack for a missing entry. The stand takes changed stacks only when its inventory
    /// did not change while the event fired.
    record potion-brew-event-post-data {
        block-pos: block-pos,
        stacks: list<item-stack>,
    }

    /// NeoForge `PlayerEnchantItemEvent`: an enchanting table applied enchantments to an item.
    /// The host takes back `enchanted-item`; the table takes it only when its slot did not change
    /// while the event fired.
    record player-enchant-item-event-data {
        player: player,
        enchanted-item: item-stack,
        enchantments: list<enchantment-value>,
    }

    /// NeoForge `GrindstoneEvent.OnTakeItem`: a player takes the result of a grindstone.
    /// Settable: `xp`, `new-top` and `new-bottom`. A cancel gives no experience and puts `top`
    /// and `bottom` back.
    record grindstone-event-on-take-item-data {
        player: player,
        /// The zero position when the player has no open container.
        block-pos: block-pos,
        top: item-stack,
        bottom: item-stack,
        xp: s32,
        /// The item of the top input slot after the take.
        new-top: item-stack,
        /// The item of the bottom input slot after the take.
        new-bottom: item-stack,
        cancelled: bool,
    }

    /// NeoForge `LevelTickEvent.Pre`: a world is about to tick, once per world and tick.
    record level-tick-event-pre-data {
        target-world: %world,
        /// Whether the tick has time left before its deadline.
        has-time: bool,
    }

    /// NeoForge `LevelTickEvent.Post`: a world ticked.
    record level-tick-event-post-data {
        target-world: %world,
        has-time: bool,
    }
}
