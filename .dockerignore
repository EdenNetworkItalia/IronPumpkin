# A whitelist of files that should be included into Docker.
# Put an exclamation mark before everything to include.

# Ignore everything
*

# Allow the source code folders
!/crates/
!/tools/
!/assets/
# The pumpkin-data build script downloads the vanilla datapack when it is missing, as in CI.
/assets/datapack

# Allow build.rs to read git commit sha
!/.git

# Dependencies
!Cargo.lock
!Cargo.toml
